# Local development profile (ENV=local, the default). Variable names and validation live in test-options.ts.
# Real environment variables always override values in this file.

# Target - HTTP(S) only, no credentials, query or fragment; a trailing slash is stripped.
HOLIDAY_BASE_URL=https://www.gov.uk/calculate-your-holiday-entitlement

# Browser - chromium | firefox | webkit. CHANNEL (chrome | msedge) requires BROWSER=chromium.
BROWSER=chromium
# CHANNEL=chrome
HEADLESS=false
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080
LOG_LEVEL=info

# Timeouts in milliseconds (integers >= 1)
STEP_TIMEOUT=60000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000
EXPECT_TIMEOUT=5000

# Execution - 0 disables parallel workers and retries
PARALLEL=0
RETRY=0

# Output - artifacts default to <REPORT_DIR>/artifacts, so overriding REPORT_DIR moves all evidence
REPORT_DIR=test-results/cucumber

# Evidence - off | on-failure | on-first-retry | on. HAR - off | record | replay (applies to @contract scenarios only)
TRACE=on-failure
HAR=off
