# CI profile (ENV=ci). The pipeline overrides BROWSER per matrix job and HAR per job type.
# Variable names and validation live in test-options.ts. Real environment variables override this file.

HOLIDAY_BASE_URL=https://www.gov.uk/calculate-your-holiday-entitlement

BROWSER=chromium
HEADLESS=true
BROWSER_WIDTH=1280
BROWSER_HEIGHT=800

# Timeouts in milliseconds - hosted runners are slower than a developer machine
STEP_TIMEOUT=90000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=45000
EXPECT_TIMEOUT=10000

# One retry absorbs live-network noise; scripts/report-flaky.cjs makes every retry visible.
PARALLEL=2
RETRY=1

REPORT_DIR=test-results/cucumber

# Trace only the first retry: first attempts run untraced, and every failure still gets screenshots.
TRACE=on-first-retry
HAR=off
