# Staging profile (ENV=staging): parallel and tolerant of transient network flakiness.
# Variable names and validation live in test-options.ts. Real environment variables override this file.

# Target - point at the staging host when one exists; GOV.UK has no public staging, so production is used.
HOLIDAY_BASE_URL=https://www.gov.uk/calculate-your-holiday-entitlement

# Browser - chromium | firefox | webkit. CHANNEL (chrome | msedge) requires BROWSER=chromium.
BROWSER=chromium
HEADLESS=true
BROWSER_WIDTH=1280
BROWSER_HEIGHT=800

# Timeouts in milliseconds (integers >= 1) - slightly more generous for shared/remote environments
STEP_TIMEOUT=90000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=45000
EXPECT_TIMEOUT=10000

# Execution
PARALLEL=2
RETRY=1

# Output - kept separate so staging runs do not overwrite local reports; artifacts follow REPORT_DIR
REPORT_DIR=test-results/staging

# Evidence - off | on-failure | on-first-retry | on. HAR - off | record | replay (applies to @contract scenarios only)
TRACE=on-failure
HAR=off
